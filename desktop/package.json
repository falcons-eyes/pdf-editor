{
  "name": "pdf-editor-desktop",
  "productName": "Sealworks",
  "version": "1.1.0",
  "description": "Sealworks: place signatures, stamps and images onto PDFs and seal them",
  "author": {
    "name": "Falcon Eyes Inc."
  },
  "license": "MIT",
  "homepage": "https://github.com/falcons-eyes/pdf-editor",
  "repository": {
    "type": "git",
    "url": "https://github.com/falcons-eyes/pdf-editor.git"
  },
  "private": true,
  "main": "src/main.js",
  "scripts": {
    "build:page": "node scripts/build-page.mjs",
    "icon": "npm run build:page && electron scripts/make-icon.cjs",
    "icon:appx": "electron scripts/make-appx-assets.cjs",
    "start": "npm run build:page && electron .",
    "pack": "npm run build:page && electron-builder --dir --publish never",
    "dist:mac": "npm run build:page && electron-builder --mac dmg --arm64 --x64 --publish never",
    "dist:win": "npm run build:page && electron-builder --win nsis portable --x64 --publish never",
    "dist:mas": "npm run build:page && electron-builder --config electron-builder.mas.cjs --mac mas --universal --publish never",
    "dist:mas-dev": "npm run build:page && electron-builder --config electron-builder.mas.cjs --mac mas-dev --universal --publish never",
    "dist:msstore": "npm run build:page && electron-builder --config electron-builder.msstore.cjs --win appx --x64 --arm64 --publish never",
    "test": "node test/seal.mjs && node test/unit.mjs && node test/smoke.mjs",
    "test:seal": "node test/seal.mjs",
    "test:unit": "node test/unit.mjs",
    "test:sandbox": "node scripts/sandbox-local.mjs"
  },
  "dependencies": {
    "@signpdf/signpdf": "4.0.0",
    "@signpdf/utils": "4.0.0",
    "node-forge": "1.4.4",
    "pdf-lib": "1.17.1"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans-kr": "5.3.0",
    "@fontsource/nanum-myeongjo": "5.3.0",
    "@fontsource/nanum-pen-script": "5.3.0",
    "electron": "45.5.0",
    "electron-builder": "26.18.0",
    "pdfjs-dist": "3.11.174",
    "playwright": "1.65.1"
  },
  "build": {
    "appId": "com.falconoon.sealworks.direct",
    "productName": "Sealworks",
    "copyright": "Copyright © 2026 Falcon Eyes Inc.",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "app/**/*",
      "package.json",
      "!**/*.map",
      "!node_modules/pdf-lib/{es,src,dist}/**",
      "!node_modules/node-forge/{dist,flash}/**",
      "!node_modules/pako/dist/**",
      "!node_modules/**/*.d.ts",
      "!node_modules/**/*.md"
    ],
    "asar": true,
    "electronLanguages": [
      "en",
      "en-US",
      "ko"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "artifactName": "Sealworks-${version}-${arch}.${ext}",
      "extendInfo": {
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "PDF Document",
            "CFBundleTypeRole": "Editor",
            "LSHandlerRank": "Alternate",
            "LSItemContentTypes": [
              "com.adobe.pdf"
            ],
            "CFBundleTypeExtensions": [
              "pdf"
            ]
          }
        ],
        "NSHumanReadableCopyright": "Copyright © 2026 Falcon Eyes Inc.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "minimumSystemVersion": "13.0"
    },
    "mas": {
      "appId": "com.falconoon.sealworks",
      "type": "distribution",
      "identity": null,
      "hardenedRuntime": false,
      "entitlements": "build/entitlements.mas.plist",
      "entitlementsInherit": "build/entitlements.mas.inherit.plist",
      "minimumSystemVersion": "13.0",
      "artifactName": "Sealworks-${version}-mas-${arch}.${ext}",
      "extraResources": [
        {
          "from": "build/mas/PrivacyInfo.xcprivacy",
          "to": "PrivacyInfo.xcprivacy"
        }
      ]
    },
    "masDev": {
      "type": "development",
      "identity": null
    },
    "dmg": {
      "sign": false,
      "title": "Sealworks ${version}",
      "artifactName": "Sealworks-${version}-${arch}.${ext}",
      "window": {
        "width": 540,
        "height": 380
      },
      "contents": [
        {
          "x": 140,
          "y": 190
        },
        {
          "x": 400,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "format": "ULFO",
      "writeUpdateInfo": false
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "installerLanguages": [
        "ko_KR",
        "en_US"
      ],
      "multiLanguageInstaller": true,
      "shortcutName": "Sealworks",
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh",
      "artifactName": "Sealworks-${version}-setup-${arch}.${ext}",
      "differentialPackage": false,
      "uninstallDisplayName": "Sealworks"
    },
    "portable": {
      "artifactName": "Sealworks-${version}-portable-${arch}.${ext}"
    },
    "publish": null
  }
}
