{
  "name": "sealworks-mobile",
  "productName": "Sealworks",
  "version": "1.2.0",
  "description": "Sealworks for Android: the Sealworks page in a Capacitor shell",
  "private": true,
  "license": "SEE LICENSE IN ../LICENSE",
  "author": { "name": "Falcon Eyes Inc." },
  "type": "module",
  "scripts": {
    "build:www": "node scripts/build-www.mjs",
    "sync": "node scripts/build-www.mjs && cap sync android",
    "icons": "node scripts/make-icons.mjs",
    "test:seal": "node scripts/build-www.mjs --seal-only && node test/seal.mjs",
    "test:android": "node test/android.mjs",
    "apk": "npm run sync && cd android && ./gradlew assembleDebug",
    "aab": "npm run sync && cd android && ./gradlew bundleRelease"
  },
  "dependencies": {
    "@capacitor/android": "8.6.2",
    "@capacitor/core": "8.6.2"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.2",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans-kr": "5.3.0",
    "@fontsource/nanum-myeongjo": "5.3.0",
    "@fontsource/nanum-pen-script": "5.3.0",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@signpdf/signpdf": "4.0.0",
    "@signpdf/utils": "4.0.0",
    "buffer": "6.0.3",
    "esbuild": "0.28.2",
    "node-forge": "1.4.4",
    "path-browserify": "1.0.1",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "3.11.174",
    "playwright-core": "1.65.1"
  }
}
